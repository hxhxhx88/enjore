{
	"Store": {
		"scope": "typescriptreact",
		"prefix": "st",
		"description": "setup a state store to start",
		"body": [
			"'use client'",
			"",
			"import type { StoreApi, UseBoundStore } from 'zustand'",
			"import { createContext, use } from 'react'",
			"import { create, useStore as useStore_ } from 'zustand'",
			"import { immer } from 'zustand/middleware/immer'",
			"",
			"export interface State {",
			"  value: string",
			"  setValue: (value: string) => void",
			"}",
			"",
			"export function createStore(): UseBoundStore<StoreApi<State>> {",
			"  return create(",
			"    immer<State>((set) => {",
			"      return {",
			"        value: '',",
			"        setValue(value: string) {",
			"          set((s) => {",
			"            s.value = value",
			"          })",
			"        },",
			"      }",
			"    }),",
			"  )",
			"}",
			"",
			"export const StoreContext = createContext<ReturnType<typeof createStore> | undefined>(undefined)",
			"",
			"export function useStore<U>(selector: (state: State) => U): U {",
			"  const store = use(StoreContext)",
			"  if (!store) {",
			"    throw new Error('useStore must be used within StoreContext')",
			"  }",
			"",
			"  return useStore_(store, selector)",
			"}",
			"",
			"export interface Props {",
			"  value: string",
			"}",
			"",
			"export const PropsContext = createContext<Props | undefined>(undefined)",
			"",
			"export function useProps(): Props {",
			"  const props = use(PropsContext)",
			"  if (!props) {",
			"    throw new Error('useProps must be used within PropsContext')",
			"  }",
			"",
			"  return props",
			"}",
		]
	},
	"StoreComponent": {
		"scope": "typescriptreact",
		"prefix": "stc",
		"description": "create a component with a store",
		"body": [
			"import type { JSX } from 'react'",
			"import type { Props } from './context'",
			"import { useMemo } from 'react'",
			"import { createStore, PropsContext, StoreContext } from './context'",
			"import { Render } from './render'",
			"",
			"export function $1(props: Props): JSX.Element {",
			"  const store = useMemo(() => createStore(), [])",
			"  return (",
			"    <PropsContext value={props}>",
			"      <StoreContext value={store}>",
			"        <Render />",
			"      </StoreContext>",
			"    </PropsContext>",
			"  )",
			"}"
		]
	},
	"Page": {
		"scope": "typescriptreact",
		"prefix": "pg",
		"description": "create a next.js page",
		"body": [
			"import type { JSX } from \"react\"",
			"",
			"export default async function Page(): Promise<JSX.Element> {",
  		"  return <div />",
			"}",
			""
		]
	}
}
