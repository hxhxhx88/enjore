# Comments live on their own lines: Task's dotenv loader treats a trailing "# ..." after an empty value as the value.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string. The default matches the local `compose.yaml` service (`task db:up`).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public origin of the web app; used for absolute URLs in metadata routes.
APP_ORIGIN=http://localhost:3000
# Sign-in session lifetime in days. The session cookie and the database row expire together.
SESSION_TTL_DAYS=30

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# Credentials for the admin panel's basic authentication.
ADMIN_BASIC_AUTH_USERNAME=
ADMIN_BASIC_AUTH_PASSWORD=

# -----------------------------------------------------------------------------
# Runners
# -----------------------------------------------------------------------------
# Bearer secret Claude presents at the admin's tool endpoint (`/api/mcp`); generate it with `openssl rand -base64 32`.
# The same value is entered once in claude.ai as the custom connector's `authorization` request header, written as
# `Bearer <value>`; that connector is how chats, scheduled tasks and Claude Code sessions reach the endpoint, so no
# other variable or file carries the connection. Mandatory: the admin does not start without it.
RUNNER_SECRET_CLAUDE=

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# API key for the Postmark email service.
POSTMARK_API_KEY=
# Postmark message stream for outbound emails (`outbound` is the default stream).
POSTMARK_MESSAGE_STREAM=
# Default sender email address. Must be a verified sender in Postmark.
EMAIL_SENDER=

# -----------------------------------------------------------------------------
# Development
# -----------------------------------------------------------------------------
# Fixed six-digit sign-in code used for development; skips sending the email.
DEV_VERIFICATION_PRIVATE_CODE=
# Comma-separated emails that receive the fixed code. When empty, every email receives it.
DEV_TESTER_EMAILS=
# Lets a request select another database through the `database` cookie, for example an isolated database per e2e
# test case. Never enable this in production.
DEV_ALLOW_DATABASE_SWITCH=false
# Comma-separated hosts the switch may point at; `*.example.com` matches any subdomain. Empty allows nothing.
DEV_DATABASE_SWITCH_HOSTS=
