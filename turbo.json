{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typegen": {
      "dependsOn": [
        "^typegen"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "typegen",
        "^typecheck"
      ]
    },
    "build": {
      "dependsOn": [
        "typegen",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    }
  },
  "globalDependencies": [
    ".env.local"
  ],
  "globalEnv": [
    "DATABASE_URL",
    "APP_ORIGIN",
    "SESSION_TTL_DAYS",
    "ADMIN_BASIC_AUTH_USERNAME",
    "ADMIN_BASIC_AUTH_PASSWORD",
    "RUNNER_SECRET_CLOUD_TASK",
    "EMAIL_SENDER",
    "POSTMARK_API_KEY",
    "POSTMARK_MESSAGE_STREAM",
    "DEV_VERIFICATION_PRIVATE_CODE",
    "DEV_TESTER_EMAILS",
    "DEV_ALLOW_DATABASE_SWITCH",
    "DEV_DATABASE_SWITCH_HOSTS"
  ]
}
